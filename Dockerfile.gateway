FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/gateway ./cmd/gateway

FROM alpine:3.22
ARG DOCKER_GID=0
RUN apk add --no-cache docker-cli git
COPY --from=build /out/gateway /gateway
RUN addgroup -S -g 1000 runspace \
    && adduser -S -u 1000 -G runspace runspace \
    && if getent group ${DOCKER_GID} >/dev/null; then \
         addgroup runspace "$(getent group ${DOCKER_GID} | cut -d: -f1)"; \
       else \
         addgroup -S -g ${DOCKER_GID} docker \
         && addgroup runspace docker; \
       fi
EXPOSE 8080
USER runspace
ENTRYPOINT ["/gateway"]
