# Local Docker Compose defaults. Copy to .env before starting.
POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge-local-password
POSTGRES_PORT=5432
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
GATEWAY_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000/gateway
NEXT_PUBLIC_WS_API_URL=http://localhost:3000/gateway
AGENT_IMAGE=runspace-agent:latest
REPOSITORY_VOLUME_NAME=runspace-repository-data
DOCKER_GID=0
ACP_COMMAND=
CHANNEL_SECRET_KEY=replace-with-a-long-local-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERS=admin:admin,alice:alice,nahid:nahid123
NEXT_PUBLIC_USER_ID=admin
GITHUB_ID=replace-with-github-oauth-client-id
GITHUB_SECRET=replace-with-github-oauth-client-secret
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
SYNCTHING_API_KEY=runspace-syncthing-local-key
SYNCTHING_SYNC_PORT=22001
